# Репозиторий предпросмотра публичный, а это внутренние рабочие материалы:
# ТЗ с аннотированными макетами не должно уезжать вместе с сайтом.
*.docx
*.doc
*.pdf

# Кроме собранных материалов сайта: пример отчёта отдаётся посетителю
# по кнопке, без него скачивание на превью не заработает.
!assets/*.pdf
